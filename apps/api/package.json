    "hono": "^4.13.16",
    "jose": "^6.2.14",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
