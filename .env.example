# --- Database (server only) ---------------------------------------------------
# Supabase: Settings → Database → Connection string (use the pooler, transaction mode).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trawer
# Used by db:reset / tests to create databases (local only).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Supabase ------------------------------------------------------------------
# Server only (apps/api). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# "supabase" in production. "dev" = local OTP 000000 without SMS (refused when NODE_ENV=production).
AUTH_MODE=dev
# "supabase" or "local" (writes to apps/web/public/uploads)
STORAGE_DRIVER=local

# --- Domains ---------------------------------------------------------------------
# Storefronts live at {slug}.ROOT_DOMAIN, dashboard at app.ROOT_DOMAIN
ROOT_DOMAIN=trawer.shop
APP_URL=http://localhost:5173

# --- Payments (use sandbox credentials outside production) ----------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PREFERRED_BANK=test-bank
# "paystack" or "fake" (local sandbox simulator)
PAYMENT_PROVIDER=fake

# --- Meta (WhatsApp Cloud API + Instagram Graph) -------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# "meta" or "console" (logs messages instead of sending)
MESSAGING_PROVIDER=console
META_GRAPH_VERSION=v23.0

# --- SMS fallback (Termii) ----------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=Trawer

# --- AI drafting ----------------------------------------------------------------------
# Snap-to-upload (photo → product draft): anthropic | fake (dev only) | off
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
# Model used for drafts (default claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Voice notes are turned into text by the phone's browser (Web Speech API); no audio is sent to Trawer.

# --- Cron + monitoring ------------------------------------------------------------------
CRON_SECRET=change-me-long-random

# --- Speed (see PERFORMANCE.md) ----------------------------------------------------------
PG_POOL_MAX=10
PG_QUERY_TIMEOUT_MS=15000
SLOW_REQUEST_MS=1000
# OpenTelemetry tracing: set an OTLP endpoint to turn it on (blank = off)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=trawer-api
SENTRY_DSN=

# --- Added with the React + Hono split ---------------------------------------------------
PORT=8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Session-mode connection for LISTEN/NOTIFY (Supabase: direct connection or session pooler)
DATABASE_LISTEN_URL=
# Production: path to apps/web/dist so the API serves the SPA on the same origin
WEB_DIST=
# Optional: server-render bundle for store home pages (default: apps/web/dist-ssr/entry-server.js beside WEB_DIST)
WEB_SSR=
# Browser build: storefront subdomains are {slug}.VITE_ROOT_DOMAIN
VITE_ROOT_DOMAIN=trawer.shop

# Reverse proxies in front of the API (load balancer/CDN). 0 = ignore X-Forwarded-For (it is client-controlled).
TRUST_PROXY_HOPS=0

# Instagram/Facebook posting: console (sandbox) or meta (needs META_APP_ID + META_APP_SECRET)
SOCIAL_PROVIDER=console
